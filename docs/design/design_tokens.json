  "state": { "hover": 0.08, "focus": 0.10, "pressed": 0.10, "dragged": 0.16, "disabledContent": 0.38, "disabledContainer": 0.12 },
  "motion": { "standard": { "duration": 300, "easing": "cubic-bezier(0.2, 0, 0, 1)" }, "emphasized": { "duration": 500, "easing": "cubic-bezier(0.2, 0, 0, 1)" }, "$description": "Respecter la réduction des animations du système" }
