  "radius": { "$type": "dimension", "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 28, "full": 999,
    "$description": "xs : champs ; sm : puces, badges ; md : cartes ; lg : sections ; xl : feuilles modales et dialogues ; full : boutons, FAB étendu, indicateurs" },
